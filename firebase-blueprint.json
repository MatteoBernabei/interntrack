{
  "entities": {
    "Application": {
      "title": "Application",
      "description": "Job application entity tracked by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "co": { "type": "string" },
        "role": { "type": "string" },
        "city": { "type": "string" },
        "country": { "type": "string" },
        "mode": { "type": "string" },
        "st": { "type": "string" },
        "fit": { "type": "number" },
        "pl": { "type": "string" },
        "comp": { "type": "string" },
        "sent": { "type": "string" },
        "prio": { "type": "string" },
        "nextStepText": { "type": "string" },
        "nextStepKind": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "co", "role", "city", "st"]
    },
    "Deadline": {
      "title": "Deadline",
      "description": "Calendar deadline, interview or follow-up event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "w": { "type": "string" },
        "t": { "type": "string" },
        "n": { "type": "string" },
        "d": { "type": "string" },
        "when": { "type": "string" },
        "c": { "type": "string" }
      },
      "required": ["n", "when", "t"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User search config and target profile preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}/applications/{appId}": {
      "schema": { "$ref": "entities/Application" },
      "description": "Stores user job applications"
    },
    "/users/{userId}/deadlines/{deadlineId}": {
      "schema": { "$ref": "entities/Deadline" },
      "description": "Stores calendar deadlines and follow-up events"
    },
    "/users/{userId}/profile/config": {
      "schema": { "$ref": "entities/UserProfile" },
      "description": "Stores user preferences and search configuration"
    }
  }
}
