# ─────────────────────────────────────────────────────────────
# InternTrack — variabili d'ambiente
# Copia questo file in ".env" (in locale) oppure inserisci le stesse chiavi
# in Vercel → Settings → Environment Variables. NON committare mai il file .env.
#
# SENZA nessuna di queste variabili l'app parte in MODALITÀ DEMO:
# dati fittizi, nessun login, funzioni AI disattivate.
# ─────────────────────────────────────────────────────────────

# ── Firebase (login Google + database) ───────────────────────
# Console Firebase → Impostazioni progetto → "Le tue app" → app Web → configurazione.
# Sono identificativi pubblici (non segreti), ma vanno comunque tenuti fuori dal codice.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Lascia vuoto per usare il database "(default)", l'unico che rientra nella quota gratuita.
VITE_FIREBASE_DATABASE_ID=

# ── Funzioni AI (server) ─────────────────────────────────────
# Chiave Gemini da https://aistudio.google.com → Get API key. SEGRETA: solo lato server.
GEMINI_API_KEY=
# Email autorizzate a usare le funzioni AI, separate da virgola. Senza questa variabile le rotte AI restano chiuse.
ALLOWED_EMAILS=
# Profilo usato nei prompt AI (testo libero; usa \n per andare a capo).
CANDIDATE_NAME=
CANDIDATE_PROFILE=

# ── Opzioni ──────────────────────────────────────────────────
# Email usata nei link "mailto" quando non sei loggato.
VITE_OWNER_EMAIL=
# ID del tuo Google Sheet di default (parte tra /d/ e /edit dell'URL). Opzionale.
VITE_DEFAULT_SHEET_ID=
# Attiva la lettura di Gmail (ambito "restricted": serve restare in modalità test con te come utente di prova).
# Non attivarlo in un sito pubblico.
VITE_ENABLE_GMAIL=false
