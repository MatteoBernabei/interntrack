# ─────────────────────────────────────────────────────────────
# InternTrack — environment variables
# Copy this file to ".env" (local) or add the same keys in
# Vercel → Settings → Environment Variables. Never commit a real .env file.
#
# WITHOUT any of these variables the app starts in DEMO MODE:
# sample data, no login, AI features disabled. That is what the public demo uses.
# ─────────────────────────────────────────────────────────────

# ── Language ─────────────────────────────────────────────────
# Default language of the interface: "en" (default) or "it".
# Visitors can still switch with the EN | IT button, or open the site with ?lang=en / ?lang=it.
VITE_APP_LANG=en

# ── Firebase (Google login + database) ───────────────────────
# Firebase console → Project settings → Your apps → Web app → config.
# These are public identifiers (not secrets), but keep them out of the code anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Leave empty to use the "(default)" database, the only one covered by the free quota.
VITE_FIREBASE_DATABASE_ID=

# ── AI features (server side) ────────────────────────────────
# Gemini key from https://aistudio.google.com → Get API key. SECRET: server only.
GEMINI_API_KEY=
# Comma-separated emails allowed to use the AI features. Without it the AI routes stay closed.
ALLOWED_EMAILS=
# Profile used in the AI prompts (free text; use \n for a new line).
CANDIDATE_NAME=
CANDIDATE_PROFILE=

# ── Options ──────────────────────────────────────────────────
# Email used in "mailto" links when you are not signed in.
VITE_OWNER_EMAIL=
# Default Google Sheet ID (the part between /d/ and /edit in the URL). Optional.
VITE_DEFAULT_SHEET_ID=
# Enables Gmail reading ("restricted" Google scope: only use it on your own private instance,
# where you are the test user). Do not enable it on a public site.
VITE_ENABLE_GMAIL=false
